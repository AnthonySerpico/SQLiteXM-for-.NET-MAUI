<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Core library: multi-target for broader compatibility -->
		<TargetFrameworks>net8.0;net10.0</TargetFrameworks>

		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Trimming / AOT compatibility analysis -->
		<IsTrimmable>true</IsTrimmable>
		<IsAotCompatible>true</IsAotCompatible>
		<EnableTrimAnalyzer>true</EnableTrimAnalyzer>
		<EnableAotAnalyzer>true</EnableAotAnalyzer>
		<EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>

		<!-- Ship XML documentation so consumers get IntelliSense tooltips from the package.
			 This also makes the compiler validate <see cref="..."/> references, which are
			 silently unchecked when documentation generation is off. -->
		<GenerateDocumentationFile>true</GenerateDocumentationFile>

		<!-- Treat documentation defects as build errors so the XML docs cannot silently
			 regress as new public members are added. Covers missing member docs (CS1591),
			 partially documented parameter lists (CS1573), unmatched param tags (CS1572),
			 and broken cref references (CS1574). -->
		<WarningsAsErrors>$(WarningsAsErrors);CS1591;CS1573;CS1572;CS1574</WarningsAsErrors>

		<!-- NuGet Package Metadata -->
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<PackageId>SQLiteXM</PackageId>
		<Version>2.0.1</Version>
		<Authors>Anthony Serpico</Authors>
		<Title>SQLiteXM - MAUI + SQLite ORM / Database Abstraction Layer</Title>
		<Description>High-performance, entity-first ORM for SQLite designed specifically for .NET MAUI applications.</Description>
		<PackageProjectUrl>https://github.com/AnthonySerpico/SQLiteXM-for-.NET-MAUI</PackageProjectUrl>
		<RepositoryUrl>https://github.com/AnthonySerpico/SQLiteXM-for-.NET-MAUI</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>sqlite;database;orm;maui;net8;net10;dotnet</PackageTags>
		<PackageReleaseNotes>Release notes for every version are published at https://github.com/AnthonySerpico/SQLiteXM-for-.NET-MAUI/releases</PackageReleaseNotes>
		<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageIcon>icon.png</PackageIcon>

		<!-- Debugging support: ship a symbol package (.snupkg) alongside the .nupkg.
			 Source is embedded directly in the PDB so consumers can step into SQLiteXM
			 without a network round-trip, and SourceLink metadata is included as a fallback. -->
		<DebugType>portable</DebugType>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<EmbedAllSources>true</EmbedAllSources>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)'=='Debug'">
		<DefineConstants>$(DefineConstants);DEBUG;SXM_DEBUG</DefineConstants>
	</PropertyGroup>

	<ItemGroup>
		<Compile Remove="SxmStore.cs" />
		<Compile Remove="SxmStoreEntity.cs" />
	</ItemGroup>

	<ItemGroup>
		<None Remove="SqlStatements\ExampleSqlStatements.json" />
		<None Remove="SqlStatements\ExampleSqlStatements.xml" />
	</ItemGroup>

	<!-- Optional: if you want to ship your example SQL statements as content in the package -->
	<ItemGroup>
		<None Include="SqlStatements\ExampleSqlStatements.json" Pack="true" PackagePath="contentFiles\any\any\SqlStatements\ExampleSqlStatements.json" />

		<!-- Include README.md in the NuGet package -->
		<None Include="..\README.md" Pack="true" PackagePath="\" />

		<!-- Include LICENSE.txt in the NuGet package -->
		<None Include="..\LICENSE.txt" Pack="true" PackagePath="\" />

		<!-- Include the package icon in the NuGet package -->
		<None Include="icon.png" Pack="true" PackagePath="\" />
	</ItemGroup>
	<ItemGroup>
	  <PackageReference Include="linq2db" Version="6.3.0" />

	  <!-- 10.0.11 and later depend on SQLitePCLRaw 2.1.12, which bundles a native SQLite
		   engine patched against CVE-2025-6965 (GHSA-2m69-gcr7-jv3q). Do not drop below
		   10.0.11 without re-pinning SQLitePCLRaw.bundle_e_sqlite3 directly. -->
	  <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
	</ItemGroup>
</Project>
