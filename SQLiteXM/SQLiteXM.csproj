<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Core library: multi-target for broader compatibility -->
		<TargetFrameworks>net8.0;net9.0</TargetFrameworks>

		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- NuGet Package Metadata -->
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<PackageId>SQLiteXM</PackageId>
		<Version>1.0.2</Version>
		<Authors>Anthony Serpico</Authors>
		<Title>SQLiteXM - MAUI + SQLite ORM / Database Abstraction Layer</Title>
		<Description>High-performance, entity-first ORM for SQLite designed specifically for .NET MAUI applications.</Description>
		<PackageProjectUrl>https://github.com/AnthonySerpico/SQLiteXM-for-.NET-MAUI</PackageProjectUrl>
		<RepositoryUrl>https://github.com/AnthonySerpico/SQLiteXM-for-.NET-MAUI</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>sqlite;database;orm;maui;net8;net9;dotnet</PackageTags>
		<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)'=='Debug'">
		<DefineConstants>$(DefineConstants);DEBUG;SXM_DEBUG</DefineConstants>
	</PropertyGroup>

	<ItemGroup>
		<Compile Remove="SxmDeleteHelpers.cs" />
		<Compile Remove="SxmInsertHelpers.cs" />
		<Compile Remove="SxmSqlStatementsUnused.cs" />
		<Compile Remove="SxmStore.cs" />
		<Compile Remove="SxmStoreEntity.cs" />
		<Compile Remove="SxmSTransaction.cs" />
		<Compile Remove="SxmTransactionHelper.cs" />
		<Compile Remove="SxmUpdateHelpers.cs" />
	</ItemGroup>

	<ItemGroup>
		<None Remove="SqlStatements\ExampleSqlStatements.json" />
		<None Remove="SqlStatements\ExampleSqlStatements.xml" />
	</ItemGroup>

	<!-- Optional: if you want to ship your example SQL statements as content in the package -->
	<ItemGroup>
		<None Include="SqlStatements\ExampleSqlStatements.json" Pack="true" PackagePath="contentFiles\any\any\SqlStatements\ExampleSqlStatements.json" />

		<None Include="SxmSqliteMetadataExtractor.cs" />

		<!-- Include README.md in the NuGet package -->
		<None Include="README.md" Pack="true" PackagePath="\" />

		<!-- Include LICENSE.txt in the NuGet package -->
		<None Include="LICENSE.txt" Pack="true" PackagePath="\" />
	</ItemGroup>
	<ItemGroup>
	  <PackageReference Include="linq2db" Version="6.3.0" />
	  <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
	</ItemGroup>
</Project>
