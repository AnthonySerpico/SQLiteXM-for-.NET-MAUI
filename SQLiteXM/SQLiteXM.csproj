<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Core library: multi-target for broader compatibility -->
		<TargetFrameworks>net8.0;net9.0</TargetFrameworks>

		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- You already had this – keep it if you want to build a NuGet package -->
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<Authors>Anthony Serpico</Authors>
		<Title>SQLiteXM - SQLite Database Abstraction Layer</Title>
		<Description>SQLiteXM makes using SQLite with .NET a snap.</Description>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)'=='Debug'">
		<DefineConstants>$(DefineConstants);SXM_DEBUG</DefineConstants>
	</PropertyGroup>

	<ItemGroup>
	  <Compile Remove="Platforms\**" />
	  <EmbeddedResource Remove="Platforms\**" />
	  <None Remove="Platforms\**" />
	</ItemGroup>

	<ItemGroup>
		<Compile Remove="SxmSqlStatementsUnused.cs" />
		<Compile Remove="SxmSTransaction.cs" />
		<Compile Remove="SxmTransactionHelper.cs" />
	</ItemGroup>

	<ItemGroup>
		<None Remove="SqlStatements\ExampleSqlStatements.json" />
		<None Remove="SqlStatements\ExampleSqlStatements.txt" />
		<None Remove="SqlStatements\ExampleSqlStatements.xml" />
	</ItemGroup>

	<ItemGroup>
		<!-- Your existing ORM dependencies -->
		<PackageReference Include="linq2db" Version="5.4.1.9" />
		<PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.10" />
	</ItemGroup>

	<!-- Optional: if you want to ship your example SQL statements as content in the package -->
	<ItemGroup>
		<None Include="SqlStatements\ExampleSqlStatements.json" Pack="true" PackagePath="contentFiles\any\any\SqlStatements\ExampleSqlStatements.json" />

		<None Include="SqlStatements\ExampleSqlStatements.txt" Pack="true" PackagePath="contentFiles\any\any\SqlStatements\ExampleSqlStatements.txt" />

		<None Include="SqlStatements\ExampleSqlStatements.xml" Pack="true" PackagePath="contentFiles\any\any\SqlStatements\ExampleSqlStatements.xml" />

		<None Include="SxmSqliteMetadataExtractor.cs" />
	</ItemGroup>
</Project>
