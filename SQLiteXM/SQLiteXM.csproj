<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Core library: multi-target for broader compatibility -->
		<TargetFrameworks>net8.0;net9.0</TargetFrameworks>

		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Trimming / AOT compatibility analysis -->
		<IsTrimmable>true</IsTrimmable>
		<IsAotCompatible>true</IsAotCompatible>
		<EnableTrimAnalyzer>true</EnableTrimAnalyzer>
		<EnableAotAnalyzer>true</EnableAotAnalyzer>
		<EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>

		<!-- NuGet Package Metadata -->
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<PackageId>SQLiteXM</PackageId>
		<Version>2.0.0</Version>
		<Authors>Anthony Serpico</Authors>
		<Title>SQLiteXM - MAUI + SQLite ORM / Database Abstraction Layer</Title>
		<Description>High-performance, entity-first ORM for SQLite designed specifically for .NET MAUI applications.</Description>
		<PackageProjectUrl>https://github.com/AnthonySerpico/SQLiteXM-for-.NET-MAUI</PackageProjectUrl>
		<RepositoryUrl>https://github.com/AnthonySerpico/SQLiteXM-for-.NET-MAUI</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>sqlite;database;orm;maui;net8;net9;dotnet</PackageTags>
		<PackageReleaseNotes>Release notes for every version are published at https://github.com/AnthonySerpico/SQLiteXM-for-.NET-MAUI/releases</PackageReleaseNotes>
		<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageIcon>icon.png</PackageIcon>

		<!-- Debugging support: ship a symbol package (.snupkg) alongside the .nupkg.
			 Source is embedded directly in the PDB so consumers can step into SQLiteXM
			 without a network round-trip, and SourceLink metadata is included as a fallback. -->
		<DebugType>portable</DebugType>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<EmbedAllSources>true</EmbedAllSources>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)'=='Debug'">
		<DefineConstants>$(DefineConstants);DEBUG;SXM_DEBUG</DefineConstants>
	</PropertyGroup>

	<ItemGroup>
		<Compile Remove="SxmStore.cs" />
		<Compile Remove="SxmStoreEntity.cs" />
	</ItemGroup>

	<ItemGroup>
		<None Remove="SqlStatements\ExampleSqlStatements.json" />
		<None Remove="SqlStatements\ExampleSqlStatements.xml" />
	</ItemGroup>

	<!-- Optional: if you want to ship your example SQL statements as content in the package -->
	<ItemGroup>
		<None Include="SqlStatements\ExampleSqlStatements.json" Pack="true" PackagePath="contentFiles\any\any\SqlStatements\ExampleSqlStatements.json" />

		<!-- Include README.md in the NuGet package -->
		<None Include="..\README.md" Pack="true" PackagePath="\" />

		<!-- Include LICENSE.txt in the NuGet package -->
		<None Include="..\LICENSE.txt" Pack="true" PackagePath="\" />

		<!-- Include the package icon in the NuGet package -->
		<None Include="icon.png" Pack="true" PackagePath="\" />
	</ItemGroup>
	<ItemGroup>
	  <PackageReference Include="linq2db" Version="6.3.0" />
	  <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
	</ItemGroup>
</Project>
