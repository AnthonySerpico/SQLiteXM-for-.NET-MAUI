<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DirectBindingDemo.ViewModels"
             x:Class="DirectBindingDemo.Views.ReviewPage"
             x:DataType="vm:ReviewViewModel"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="20">

            <Label Text="Step 4: Review &amp; Complete" 
                   Style="{StaticResource SubHeadline}"/>

            <Label Text="Review Your Information"
                   FontSize="14"
                   FontAttributes="Bold"
                   Margin="0,10,0,0"/>

            <!-- Personal Information Section -->
            <Frame BorderColor="{StaticResource Primary}" Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Personal Details" 
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}"/>

                    <!-- DIRECT BINDING: Displays computed property CurrentUser.FullName -->
                    <HorizontalStackLayout Spacing="10">
                        <Label Text="Name:" FontAttributes="Bold" WidthRequest="100"/>
                        <Label Text="{Binding CurrentUser.FullName}"/>
                    </HorizontalStackLayout>

                    <!-- DIRECT BINDING: Displays CurrentUser.Email -->
                    <HorizontalStackLayout Spacing="10">
                        <Label Text="Email:" FontAttributes="Bold" WidthRequest="100"/>
                        <Label Text="{Binding CurrentUser.Email}"/>
                    </HorizontalStackLayout>

                    <!-- DIRECT BINDING: Displays computed property CurrentUser.Age -->
                    <HorizontalStackLayout Spacing="10">
                        <Label Text="Age:" FontAttributes="Bold" WidthRequest="100"/>
                        <Label Text="{Binding CurrentUser.Age}"/>
                    </HorizontalStackLayout>

                    <!-- DIRECT BINDING: Displays CurrentUser.DateOfBirth with formatting -->
                    <HorizontalStackLayout Spacing="10">
                        <Label Text="Birthday:" FontAttributes="Bold" WidthRequest="100"/>
                        <Label Text="{Binding CurrentUser.DateOfBirth, StringFormat='{0:MMMM d, yyyy}'}"/>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Frame>

            <!-- Preferences Section -->
            <Frame BorderColor="{StaticResource Info}" Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Preferences" 
                           FontAttributes="Bold"
                           TextColor="{StaticResource Info}"/>

                    <HorizontalStackLayout Spacing="10">
                        <Label Text="Notifications:" FontAttributes="Bold" WidthRequest="100"/>
                        <Label Text="{Binding NotificationsStatus}"/>
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="10">
                        <Label Text="Referral:" FontAttributes="Bold" WidthRequest="100"/>
                        <Label Text="{Binding CurrentPreferences.ReferralCode}"/>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Frame>

            <!-- Direct Binding Explanation -->
            <Frame BorderColor="{StaticResource Success}" Padding="15" Margin="0,20,0,0">
                <VerticalStackLayout Spacing="8">
                    <Label Text="✨ Direct Binding Demonstrated"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Success}"/>
                    <Label FontSize="12" TextColor="{StaticResource Gray600}">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="All values above are bound directly to entity properties:" />
                                <Span Text="&#x0a;• " />
                                <Span Text="FullName" FontFamily="Courier" TextColor="{StaticResource Success}" />
                                <Span Text=" (computed from FirstName + LastName)" />
                                <Span Text="&#x0a;• " />
                                <Span Text="Age" FontFamily="Courier" TextColor="{StaticResource Success}" />
                                <Span Text=" (computed from DateOfBirth)" />
                                <Span Text="&#x0a;• " />
                                <Span Text="Email, DateOfBirth" FontFamily="Courier" TextColor="{StaticResource Success}" />
                                <Span Text=" (stored properties)" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </VerticalStackLayout>
            </Frame>

            <Label Text="{Binding ErrorMessage}"
                   TextColor="{StaticResource Danger}"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}"
                   Margin="0,10"/>

            <Button Text="Complete Registration" 
                    Command="{Binding CompleteRegistrationCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                    BackgroundColor="{StaticResource Success}"
                    Margin="0,20,0,0"/>

            <ActivityIndicator IsRunning="{Binding IsBusy}" 
                              IsVisible="{Binding IsBusy}"
                              HorizontalOptions="Center"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
