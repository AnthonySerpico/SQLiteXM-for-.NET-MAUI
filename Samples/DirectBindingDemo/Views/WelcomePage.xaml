<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DirectBindingDemo.ViewModels"
             x:Class="DirectBindingDemo.Views.WelcomePage"
             x:DataType="vm:WelcomeViewModel"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="25">

            <Label Text="Direct Binding Demo" 
                   Style="{StaticResource Headline}"
                   SemanticProperties.HeadingLevel="Level1"
                   Margin="0,40,0,0"/>

            <Label Text="SQLiteXM for .NET MAUI" 
                   Style="{StaticResource SubHeadline}"
                   SemanticProperties.HeadingLevel="Level2"/>

            <BoxView HeightRequest="2" 
                     Color="{StaticResource Primary}"
                     Margin="0,20"/>

            <Label TextColor="{StaticResource Gray600}"
                   FontSize="16"
                   HorizontalTextAlignment="Center"
                   Margin="0,10">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="This sample demonstrates " />
                        <Span Text="DIRECT BINDING" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                        <Span Text=" to SxmEntity properties.&#x0a;&#x0a;" />
                        <Span Text="UI controls bind directly to entity properties like " />
                        <Span Text="User.FirstName" FontFamily="Courier" TextColor="{StaticResource Success}" />
                        <Span Text=" and " />
                        <Span Text="User.Email" FontFamily="Courier" TextColor="{StaticResource Success}" />
                        <Span Text=".&#x0a;&#x0a;" />
                        <Span Text="Computed properties like " />
                        <Span Text="FullName" FontFamily="Courier" TextColor="{StaticResource Info}" />
                        <Span Text=" update automatically as you type!" />
                    </FormattedString>
                </Label.FormattedText>
            </Label>

            <Button Text="Start Registration" 
                    Command="{Binding StartRegistrationCommand}"
                    Margin="0,40,0,0"
                    VerticalOptions="Center"/>

            <Label Text="Pattern Comparison:"
                   FontAttributes="Bold"
                   FontSize="14"
                   Margin="0,40,0,10"/>

            <Frame BorderColor="{StaticResource Gray300}" Padding="15" Margin="0,0,0,10">
                <VerticalStackLayout Spacing="5">
                    <Label Text="📋 RegistrationDemo"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}"/>
                    <Label Text="UI → ViewModel props → Entity"
                           FontSize="12"
                           TextColor="{StaticResource Gray600}"/>
                    <Label Text="(Field copying required)"
                           FontSize="10"
                           FontAttributes="Italic"
                           TextColor="{StaticResource Gray500}"/>
                </VerticalStackLayout>
            </Frame>

            <Frame BorderColor="{StaticResource Success}" Padding="15">
                <VerticalStackLayout Spacing="5">
                    <Label Text="✨ DirectBindingDemo"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Success}"/>
                    <Label Text="UI ↔ Entity directly"
                           FontSize="12"
                           TextColor="{StaticResource Gray600}"/>
                    <Label Text="(No field copying needed!)"
                           FontSize="10"
                           FontAttributes="Italic"
                           TextColor="{StaticResource Gray500}"/>
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
