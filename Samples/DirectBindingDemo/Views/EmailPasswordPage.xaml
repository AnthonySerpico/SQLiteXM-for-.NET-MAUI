<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DirectBindingDemo.ViewModels"
             x:Class="DirectBindingDemo.Views.EmailPasswordPage"
             x:DataType="vm:EmailPasswordViewModel"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="20">

            <Label Text="Step 1: Email &amp; Password" 
                   Style="{StaticResource SubHeadline}"/>

            <Label Text="Direct Binding to Entity"
                   FontSize="12"
                   TextColor="{StaticResource Info}"
                   FontAttributes="Italic"
                   Margin="0,0,0,10">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="Email binds directly to " />
                        <Span Text="CurrentUser.Email" FontFamily="Courier" TextColor="{StaticResource Success}" />
                        <Span Text=" - no intermediate ViewModel property needed! Every keystroke updates the entity immediately. This eliminates manual copying between ViewModel and entity, reducing bugs and boilerplate code." />
                    </FormattedString>
                </Label.FormattedText>
            </Label>

            <!-- DIRECT BINDING: Email entry binds to CurrentUser.Email (entity property) -->
            <Border Stroke="{StaticResource Gray300}" StrokeThickness="1" Padding="10" Margin="0,10,0,0">
                <VerticalStackLayout>
                    <Label Text="Email Address *" FontSize="12" TextColor="{StaticResource Gray600}"/>
                    <Entry Text="{Binding CurrentUser.Email}" 
                           Placeholder="your@email.com"
                           Keyboard="Email"/>
                </VerticalStackLayout>
            </Border>

            <!-- Password fields (not directly bound to entity for security) -->
            <Label Text="Why Not Direct Binding for Passwords?"
                   FontSize="12"
                   TextColor="{StaticResource Gray600}"
                   FontAttributes="Italic"
                   Margin="0,10,0,5">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="Password fields bind to ViewModel properties (" />
                        <Span Text="Password, ConfirmPassword" FontFamily="Courier" TextColor="{StaticResource Primary}" />
                        <Span Text=") for validation and hashing before storing. We never store plain-text passwords in entities!" />
                    </FormattedString>
                </Label.FormattedText>
            </Label>

            <Border Stroke="{StaticResource Gray300}" StrokeThickness="1" Padding="10">
                <VerticalStackLayout>
                    <Label Text="Password *" FontSize="12" TextColor="{StaticResource Gray600}"/>
                    <Entry Text="{Binding Password}" 
                           Placeholder="Min 6 characters"
                           IsPassword="True"/>
                </VerticalStackLayout>
            </Border>

            <Border Stroke="{StaticResource Gray300}" StrokeThickness="1" Padding="10">
                <VerticalStackLayout>
                    <Label Text="Confirm Password *" FontSize="12" TextColor="{StaticResource Gray600}"/>
                    <Entry Text="{Binding ConfirmPassword}" 
                           Placeholder="Re-enter password"
                           IsPassword="True"/>
                </VerticalStackLayout>
            </Border>

            <Label Text="{Binding ErrorMessage}"
                   TextColor="{StaticResource Danger}"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}"
                   Margin="0,10"/>

            <Button Text="Next" 
                    Command="{Binding NextCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                    Margin="0,20,0,0"/>

            <ActivityIndicator IsRunning="{Binding IsBusy}" 
                              IsVisible="{Binding IsBusy}"
                              HorizontalOptions="Center"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
