<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:QueryGalleryDemo.ViewModels"
             xmlns:models="clr-namespace:QueryGalleryDemo.Models"
             x:Class="QueryGalleryDemo.Views.QueryCategoryPage"
             x:DataType="vm:QueryCategoryViewModel"
             Title="{Binding Title}">

    <Grid RowDefinitions="Auto,*" Padding="20" RowSpacing="15">

        <!-- Header -->
        <Label Grid.Row="0"
               Text="{Binding Title}"
               FontSize="28"
               FontAttributes="Bold"
               TextColor="{StaticResource Primary}"
               Margin="0,10,0,0"/>

        <!-- Query List -->
        <CollectionView Grid.Row="1"
                       ItemsSource="{Binding QueryExamples}"
                       SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:QueryExample">
                    <Frame Padding="0" 
                           Margin="0,0,0,10"
                           BorderColor="{StaticResource Gray300}"
                           BackgroundColor="Transparent">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:QueryCategoryViewModel}}, Path=SelectQueryCommand}"
                                                CommandParameter="{Binding .}"/>
                        </Frame.GestureRecognizers>
                        <Grid Padding="15" ColumnDefinitions="*,Auto" ColumnSpacing="10">

                            <!-- Query Info -->
                            <VerticalStackLayout Grid.Column="0" Spacing="5">
                                <Label Text="{Binding Name}"
                                       FontSize="18"
                                       FontAttributes="Bold"/>
                                <Label Text="{Binding Description}"
                                       FontSize="14"
                                       TextColor="{StaticResource Gray600}"/>
                                <HorizontalStackLayout Spacing="10">
                                    <Label Text="{Binding Type}"
                                           FontSize="12"
                                           TextColor="{StaticResource Primary}"
                                           FontFamily="Courier"/>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>

                            <!-- Arrow -->
                            <Label Grid.Column="1"
                                   Text="▶"
                                   FontSize="20"
                                   TextColor="{StaticResource Primary}"
                                   VerticalOptions="Center"/>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>

</ContentPage>
