<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:QueryGalleryDemo.ViewModels"
             x:Class="QueryGalleryDemo.Views.QueryExecutionPage"
             x:DataType="vm:QueryExecutionViewModel"
             Title="{Binding Title}">

    <Grid RowDefinitions="Auto,*,Auto,*,Auto" Padding="15" RowSpacing="10">

        <!-- Query Description -->
        <Frame Grid.Row="0" 
               Padding="15"
               BorderColor="{StaticResource Primary}"
               BackgroundColor="{StaticResource Gray100}"
               IsVisible="{Binding QueryExample, Converter={StaticResource IsNotNullConverter}}">
            <VerticalStackLayout Spacing="8">
                <Label Text="{Binding QueryExample.Description, FallbackValue='Loading...'}"
                       FontSize="14"
                       TextColor="{StaticResource Gray900}"/>
                <Label Text="{Binding QueryExample.Type, StringFormat='Type: {0}', FallbackValue='Type: Unknown'}"
                       FontSize="12"
                       TextColor="{StaticResource Primary}"
                       FontFamily="Courier"/>

                <!-- Show actual SQL statement for RawSql queries -->
                <Label Text="{Binding QueryExample.ActualSqlStatement}"
                       FontSize="11"
                       FontFamily="Courier"
                       TextColor="{StaticResource Gray600}"
                       LineBreakMode="WordWrap"
                       IsVisible="{Binding QueryExample.ActualSqlStatement, Converter={StaticResource StringNotEmptyConverter}}"
                       Margin="0,5,0,0"/>
            </VerticalStackLayout>
        </Frame>

        <!-- Code Display (Top Pane) - Split into Code and Explanation -->
        <Grid Grid.Row="1" ColumnDefinitions="*,10,*">

            <!-- Left Side: Query Code -->
            <Grid Grid.Column="0" RowDefinitions="Auto,*">
                <Label Grid.Row="0" 
                       Text="📝 Query Code"
                       FontSize="16"
                       FontAttributes="Bold"
                       TextColor="{StaticResource Primary}"
                       Margin="0,0,0,5"/>

                <!-- Code display with overlay copy button -->
                <Grid Grid.Row="1">
                    <ScrollView>
                        <Frame Padding="15"
                               BorderColor="{StaticResource Gray300}"
                               BackgroundColor="{StaticResource Gray100}">
                            <Label Text="{Binding FormattedCode}"
                                   FontFamily="Courier"
                                   FontSize="12"
                                   TextColor="{StaticResource Gray900}"
                                   LineBreakMode="WordWrap"/>
                        </Frame>
                    </ScrollView>

                    <!-- Copy button overlay in top-right corner -->
                    <Button Text="📋"
                            FontSize="18"
                            Command="{Binding CopyCodeCommand}"
                            BackgroundColor="#F5F5F5"
                            BorderColor="{StaticResource Gray300}"
                            BorderWidth="1"
                            TextColor="{StaticResource Primary}"
                            Padding="8"
                            Margin="10"
                            WidthRequest="36"
                            HeightRequest="36"
                            HorizontalOptions="End"
                            VerticalOptions="Start"
                            CornerRadius="6"
                            ToolTipProperties.Text="Copy code to clipboard"/>
                </Grid>
            </Grid>

            <!-- Visual Separator -->
            <BoxView Grid.Column="1" 
                     Color="{StaticResource Gray300}"
                     WidthRequest="2"
                     HorizontalOptions="Center"/>

            <!-- Right Side: Explanation -->
            <Grid Grid.Column="2" RowDefinitions="Auto,*">
                <Label Grid.Row="0" 
                       Text="💡 Explanation"
                       FontSize="16"
                       FontAttributes="Bold"
                       TextColor="{StaticResource Primary}"
                       Margin="0,0,0,5"/>

                <ScrollView Grid.Row="1">
                    <Frame Padding="15"
                           BorderColor="{StaticResource Gray300}"
                           BackgroundColor="{StaticResource Gray100}">
                        <Label Text="{Binding QueryExample.Explanation, FallbackValue='No explanation available.'}"
                               FontSize="12"
                               TextColor="{StaticResource Gray900}"
                               LineBreakMode="WordWrap"/>
                    </Frame>
                </ScrollView>
            </Grid>
        </Grid>

        <!-- Run Button & Status -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="0,10">

            <Button Grid.Column="0"
                    Text="▶ Run Query"
                    Command="{Binding RunQueryCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                    HeightRequest="45"/>

            <ActivityIndicator Grid.Column="1"
                             IsRunning="{Binding IsBusy}"
                             IsVisible="{Binding IsBusy}"
                             Color="{StaticResource Primary}"
                             WidthRequest="30"
                             HeightRequest="30"
                             VerticalOptions="Center"/>
        </Grid>

        <!-- Results Display (Bottom Pane) -->
        <Grid Grid.Row="3" RowDefinitions="Auto,*" IsVisible="{Binding HasResults}">

            <HorizontalStackLayout Grid.Row="0" Spacing="15" Margin="0,0,0,5">
                <Label Text="📊 Results"
                       FontSize="16"
                       FontAttributes="Bold"
                       TextColor="{StaticResource Primary}"/>
                <Label Text="{Binding RecordCount, StringFormat='Records: {0}'}"
                       FontSize="14"
                       TextColor="{StaticResource Success}"
                       VerticalOptions="Center"/>
                <Label Text="{Binding ExecutionTimeMs, StringFormat='Time: {0}ms'}"
                       FontSize="14"
                       TextColor="{StaticResource Info}"
                       VerticalOptions="Center"/>
            </HorizontalStackLayout>

            <ScrollView Grid.Row="1">
                <Frame Padding="10"
                       BorderColor="{StaticResource Gray300}"
                       BackgroundColor="{StaticResource Gray100}">
                    <!-- Formatted results display -->
                    <Label Text="{Binding FormattedResults}"
                           FontFamily="Courier"
                           FontSize="11"
                           TextColor="{StaticResource Gray900}"
                           LineBreakMode="WordWrap"/>
                </Frame>
            </ScrollView>
        </Grid>

        <!-- Error Display -->
        <Frame Grid.Row="4"
               Padding="15"
               BorderColor="{StaticResource Danger}"
               BackgroundColor="#FFEBEE"
               IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}">
            <Label Text="{Binding ErrorMessage}"
                   TextColor="{StaticResource Danger}"
                   FontSize="14"/>
        </Frame>

    </Grid>

</ContentPage>
