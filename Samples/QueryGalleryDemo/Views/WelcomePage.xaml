<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:QueryGalleryDemo.ViewModels"
             x:Class="QueryGalleryDemo.Views.WelcomePage"
             x:DataType="vm:WelcomeViewModel"
             Title="{Binding Title}">

    <Grid Padding="40" RowSpacing="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <VerticalStackLayout Grid.Row="0" Spacing="10">
            <Label Text="🎵 Query Gallery Demo"
                   FontSize="36"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="{StaticResource Primary}"/>

            <Label Text="SQLiteXM Query Examples"
                   FontSize="18"
                   HorizontalOptions="Center"
                   TextColor="{StaticResource Gray600}"/>
        </VerticalStackLayout>

        <!-- Info Box -->
        <Frame Grid.Row="1"
               Padding="30"
               BorderColor="{StaticResource Primary}"
               BackgroundColor="{StaticResource Gray100}"
               VerticalOptions="Center">
            <VerticalStackLayout Spacing="15">
                <Label Text="Welcome to QueryGallery!"
                       FontSize="20"
                       FontAttributes="Bold"/>

                <Label TextType="Html">
                    <Label.Text>
                        <![CDATA[
                        This app demonstrates <b>SQLiteXM</b> query capabilities with a Chinook-style music database containing <b>~25,000 records</b><br/><br/>
                        ]]>
                    </Label.Text>
                </Label>

                <Label Text="You'll explore:"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"/>

                <Grid ColumnSpacing="90" HorizontalOptions="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Label Grid.Column="0" TextType="Html">
                        <Label.Text>
                            <![CDATA[• Basic Queries<br/>• Relationship Queries (Joins)<br/>• Aggregations (COUNT, SUM, GROUP BY)<br/>• Advanced LINQ<br/>• Raw SQL Examples<br/>• Performance Demos]]>
                        </Label.Text>
                    </Label>

                    <Label Grid.Column="1" TextType="Html">
                        <Label.Text><![CDATA[• Many-to-Many Relationships<br/>• Transactions (ACID Operations)<br/>• Parameterized Queries (Safe SQL)<br/>• Data Modification (INSERT/UPDATE/DELETE)<br/>• Mixed Transactions (LINQ + SQL + Entity DML)]]></Label.Text>
                    </Label>
                </Grid>
            </VerticalStackLayout>
        </Frame>

        <!-- Seeding Status -->
        <VerticalStackLayout Grid.Row="2" Spacing="15" IsVisible="{Binding IsSeeding}">
            <ProgressBar Progress="{Binding ProgressValue}"
                        HeightRequest="20"
                        ProgressColor="{StaticResource Primary}"
                        Margin="0,10,0,0"/>

            <Label Text="{Binding ProgressText}"
                   FontSize="16"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="{StaticResource Primary}"/>

            <Label Text="{Binding SeedingStatus}"
                   FontSize="14"
                   HorizontalOptions="Center"
                   TextColor="{StaticResource Gray600}"/>

            <ActivityIndicator IsRunning="{Binding IsSeeding}"
                             HeightRequest="30"
                             WidthRequest="30"
                             HorizontalOptions="Center"
                             Color="{StaticResource Primary}"/>
        </VerticalStackLayout>

        <!-- Continue Button -->
        <Button Grid.Row="3"
                Text="Explore Queries"
                Command="{Binding ContinueCommand}"
                IsVisible="{Binding SeedingComplete}"
                HorizontalOptions="Center"
                WidthRequest="250"
                HeightRequest="50"
                FontSize="18"
                Margin="0,20,0,0"/>

        <!-- Error Message -->
        <Label Grid.Row="3"
               Text="{Binding ErrorMessage}"
               TextColor="{StaticResource Danger}"
               IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}"
               HorizontalOptions="Center"
               Margin="0,20,0,0"/>
    </Grid>

</ContentPage>
